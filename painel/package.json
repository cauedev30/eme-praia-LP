{
  "name": "eme-praia-painel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../.wrangler-state",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply eme-praia --local --persist-to ../.wrangler-state",
    "db:migrate:remote": "wrangler d1 migrations apply eme-praia --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@cloudflare/workers-types": "^5.20260914.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.131.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
